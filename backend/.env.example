DATABASE_URL=postgresql://postgres:change-this-postgres-password@localhost:5432/threat_intel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

AUTOSCAN_ENABLED=false
AUTOSCAN_DEFAULT_INTERVAL_MINUTES=180
AUTOSCAN_ALLOWED_HOSTS=127.0.0.1,localhost

SECRET_KEY=replace-with-a-unique-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Authentication credentials (set unique values; never commit real secrets)
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ANALYST_PASSWORD=replace-with-a-strong-investigator-password
SCANNER_SERVICE_PASSWORD=replace-with-a-strong-service-password

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

CORRELATION_EXCLUDE_SYNTHETIC_DEMO_EVIDENCE=true

SCANNER_TLS_VERIFY=true
SCANNER_CONNECT_TIMEOUT_SECONDS=10
SCANNER_MAX_RESPONSE_BYTES=1000000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-in-local-env
POSTGRES_PASSWORD=change-this-in-local-env

COLLECTION_ENABLED=false
COLLECTION_POLL_INTERVAL_MINUTES=5
COLLECTION_ALLOWED_HOSTS=127.0.0.1,localhost
COLLECTION_TIMEOUT_SECONDS=20
COLLECTION_MAX_RESPONSE_BYTES=2000000

TOR_SOCKS5_PROXY=socks5h://127.0.0.1:9050
TOR_ALLOWED_ONION_HOSTS=
TOR_TIMEOUT_SECONDS=30
TOR_DESCRIPTOR_URL=

LEDGER_BLOCK_SIZE=32
BLOCKCHAIN_ANCHOR_RPC_URL=
BLOCKCHAIN_ANCHOR_CONTRACT=
MEDIA_MAX_BYTES=5000000
