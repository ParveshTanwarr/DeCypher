DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/threat_intel
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=threatpassword
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
SECRET_KEY=change_this_to_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Autonomous scanning is opt-in and disabled by default.
AUTOSCAN_ENABLED=false
AUTOSCAN_DEFAULT_INTERVAL_MINUTES=180
# Only explicitly authorized demo/test hosts should be listed here.
AUTOSCAN_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional investigation copilot
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
